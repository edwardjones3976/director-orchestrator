# Runtime
APP_ENV=local
LOG_LEVEL=INFO
TZ=America/Los_Angeles
ORCHESTRATOR_BASE_URL=http://orchestrator:8080
ORCHESTRATOR_SHARED_SECRET=REPLACE_WITH_RANDOM_SECRET
ALLOW_PAID_RUNS=false
MAX_AGENT_HOPS=6
MAX_REVISIONS=2
MAX_TASK_BUDGET_USD=2.00
PROVIDER_POLL_SECONDS=15
PROVIDER_TIMEOUT_SECONDS=3600
SQLITE_PATH=/data/director.sqlite3

# [[Codex | GPT-5.6 | 2026-08-22 16:05 UTC | BEGIN]]
# Default-on LangGraph proof lanes. These use state separate from the legacy task store.
LANGGRAPH_SHADOW_ENABLED=true
LANGGRAPH_APPROVAL_RESUME_ENABLED=true
LANGGRAPH_CHECKPOINT_PATH=/data/langgraph-shadow.sqlite3
LANGGRAPH_CHECKPOINT_NAMESPACE=director-local-shadow-v1
# [[Codex | GPT-5.6 | 2026-08-22 16:05 UTC | END]]
PROJECT_ALLOWLIST=
REPOSITORY_ALLOWLIST=
ALLOWED_STARTING_REFS=main

# Periodic provider availability/usage prompts. Explicitly opt in only after provider limits are set.
USAGE_CHECK_ENABLED=false
USAGE_CHECK_INTERVAL_MINUTES=360
USAGE_CHECK_INITIAL_DELAY_SECONDS=60
USAGE_CHECK_PROVIDER_DELAY_SECONDS=5
USAGE_CHECK_TIMEOUT_SECONDS=300
USAGE_CHECK_MAX_OUTPUT_TOKENS=96
USAGE_CHECK_PROVIDERS=openai,claude,cursor,grok

# Owner subscription context for routing. Consumer plans do not imply API quota.
PRIMARY_TEAM=openai,claude,cursor,grok
PRIMARY_WORKHORSE=claude
CLAUDE_ACCOUNT_CONTEXT=Claude Pro 20x
OPENAI_ACCOUNT_CONTEXT=ChatGPT Plus; OpenAI API usage is billed separately
OTHER_PROVIDER_ACCOUNT_CONTEXT=Comparable paid individual tiers; API billing and quotas must be verified separately

# Slack — create from slack-app-manifest.yaml
SLACK_APP_TOKEN=
SLACK_BOT_TOKEN=
SLACK_DIRECTOR_CHANNEL_ID=C0BQ6GSCNLR
SLACK_OWNER_USER_ID=U0B9UJ86D27
SLACK_GATEWAY_SECRET=REPLACE_WITH_DISTINCT_RANDOM_SECRET
N8N_DIRECTOR_WEBHOOK_URL=http://n8n:5678/webhook/director-intake

# [[Codex | GPT-5.6 | 2026-08-23 08:31 UTC | BEGIN]]
# Owner-only shared-channel alias for the official ChatGPT Slack identity.
# Every paid answer needs a second signed owner approval. Ambiguous Slack delivery
# needs an explicit owner RECOVER command and may duplicate an accepted message.
# Temporary encrypted recovery expires; rotating gateway/internal secrets invalidates it.
# Replies are posted honestly by Aesop Director; no work-order authority is granted.
CHATGPT_BRIDGE_ENABLED=false
CHATGPT_BRIDGE_SLACK_USER_ID=U0B9KFJPST1
CHATGPT_BRIDGE_CHANNEL_IDS=C0BQ6GSCNLR,C0BAV9CMC80
CHATGPT_BRIDGE_MAX_PROMPT_CHARS=4000
CHATGPT_BRIDGE_MAX_OUTPUT_TOKENS=600
CHATGPT_BRIDGE_REQUESTS_PER_MINUTE=4
CHATGPT_BRIDGE_ESTIMATED_COST_USD=0.10
CHATGPT_BRIDGE_DAILY_BUDGET_USD=2.00
# [[Codex | GPT-5.6 | 2026-08-23 08:31 UTC | END]]

# OpenAI Director — API billing is separate from ChatGPT subscriptions
OPENAI_API_KEY=
OPENAI_DIRECTOR_MODEL=gpt-5.6
OPENAI_REASONING_EFFORT=medium
# Trusted minimum reservation for each paid counter-bias, synthesis, or tie turn.
OPENAI_DEBATE_TURN_ESTIMATED_COST_USD=0.05

# Cursor Cloud Agents
CURSOR_API_KEY=
CURSOR_API_BASE=https://api.cursor.com
CURSOR_DISPATCH_MAX_ATTEMPTS=4
CURSOR_DISPATCH_MAX_RETRY_DELAY_SECONDS=60

# Claude Code Routine — URL ends in /fire
CLAUDE_ROUTINE_URL=
CLAUDE_ROUTINE_TOKEN=
CLAUDE_CALLBACK_SECRET=
CLAUDE_ROUTINE_BETA=experimental-cc-routine-2026-04-01

# Gemini Antigravity managed agent
GEMINI_API_KEY=
GEMINI_API_BASE=https://generativelanguage.googleapis.com/v1beta
GEMINI_AGENT=antigravity-preview-05-2026
GEMINI_API_REVISION=2026-05-20
GEMINI_USAGE_MODEL=gemini-3.5-flash-lite
GEMINI_USAGE_MAX_ATTEMPTS=3
GEMINI_USAGE_MAX_RETRY_DELAY_SECONDS=8
GEMINI_MAX_TOTAL_TOKENS=20000
GEMINI_DAILY_BUDGET_USD=2.00
GEMINI_DAILY_REQUEST_LIMIT=50
# Antigravity subordinate lane; readiness fails closed on any other value.
GEMINI_MODE=antigravity_subordinate
GEMINI_ALLOW_REVIEW_VERDICT=false
GEMINI_ALLOW_PRIMARY_AUTHORITY=false

# xAI Grok primary Cursor-family teammate. The API contact remains tool-free;
# Grok Build and Grok Bot are separate repository-capable contacts.
GROK_ENABLED=false
XAI_API_KEY=
GROK_API_BASE=https://api.x.ai/v1
GROK_MODEL=grok-4.6
GROK_MODE=cursor_family_primary
GROK_TIMEOUT_SECONDS=180
GROK_MAX_OUTPUT_TOKENS=4096
GROK_MAX_CONTEXT_CHARS=262144
GROK_DAILY_BUDGET_USD=2.00
GROK_DAILY_REQUEST_LIMIT=50
GROK_REQUEST_COST_FLOOR_USD=0.01
GROK_ALLOW_TOOLS=false
GROK_ALLOW_REPOSITORY_WRITE=false
GROK_ALLOW_REVIEW_VERDICT=false
GROK_CLI_ENABLED=false
GROK_CLI_EXECUTABLE=
GROK_CLI_EXECUTABLE_SHA256=
GROK_CLI_REPOSITORY_MAP_JSON={}
GROK_CLI_TIMEOUT_SECONDS=3600
GROK_CLI_MAX_TURNS=20

# Perplexity API Platform (raw Search API for assignments)
PERPLEXITY_ENABLED=false
PERPLEXITY_API_KEY=
PERPLEXITY_API_BASE=https://api.perplexity.ai
PERPLEXITY_PRESET=fast-search
PERPLEXITY_MODE=research_only
PERPLEXITY_MAX_RESULTS=10
PERPLEXITY_SEARCH_CONTEXT_SIZE=high
PERPLEXITY_TIMEOUT_SECONDS=180
PERPLEXITY_DAILY_BUDGET_USD=2.00
PERPLEXITY_DAILY_REQUEST_LIMIT=100
PERPLEXITY_ALLOW_REPOSITORY_WRITE=false
PERPLEXITY_ALLOW_REVIEW_VERDICT=false

# n8n local deployment
N8N_IMAGE=docker.n8n.io/n8nio/n8n:latest@sha256:d91033b4fac2f7b75c5c4007e10824c66147f7d7a3cccb488720e97452ee7dc7
N8N_ENCRYPTION_KEY=REPLACE_WITH_RANDOM_SECRET
N8N_POSTGRES_PASSWORD=REPLACE_WITH_RANDOM_SECRET
