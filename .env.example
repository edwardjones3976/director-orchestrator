# Runtime
APP_ENV=local
LOG_LEVEL=INFO
TZ=America/Los_Angeles
ORCHESTRATOR_BASE_URL=http://orchestrator:8080
ORCHESTRATOR_SHARED_SECRET=REPLACE_WITH_RANDOM_SECRET
ALLOW_PAID_RUNS=false
MAX_AGENT_HOPS=6
MAX_REVISIONS=2
MAX_TASK_BUDGET_USD=2.00
PROVIDER_POLL_SECONDS=15
PROVIDER_TIMEOUT_SECONDS=3600
SQLITE_PATH=/data/director.sqlite3

# Periodic provider availability/usage prompts. These never run while ALLOW_PAID_RUNS=false.
USAGE_CHECK_ENABLED=true
USAGE_CHECK_INTERVAL_MINUTES=360
USAGE_CHECK_INITIAL_DELAY_SECONDS=60
USAGE_CHECK_PROVIDER_DELAY_SECONDS=5
USAGE_CHECK_TIMEOUT_SECONDS=300
USAGE_CHECK_MAX_OUTPUT_TOKENS=96
USAGE_CHECK_PROVIDERS=openai,claude,cursor

# Owner subscription context for routing. Consumer plans do not imply API quota.
PRIMARY_TEAM=openai,claude,cursor
PRIMARY_WORKHORSE=claude
CLAUDE_ACCOUNT_CONTEXT=Claude Pro 20x
OPENAI_ACCOUNT_CONTEXT=ChatGPT Plus; OpenAI API usage is billed separately
OTHER_PROVIDER_ACCOUNT_CONTEXT=Comparable paid individual tiers; API billing and quotas must be verified separately

# Slack — create from slack-app-manifest.yaml
SLACK_APP_TOKEN=
SLACK_BOT_TOKEN=
SLACK_DIRECTOR_CHANNEL_ID=C0BQ6GSCNLR
SLACK_OWNER_USER_ID=U0B9UJ86D27
N8N_DIRECTOR_WEBHOOK_URL=http://n8n:5678/webhook/director-intake

# OpenAI Director — API billing is separate from ChatGPT subscriptions
OPENAI_API_KEY=
OPENAI_DIRECTOR_MODEL=gpt-5.6
OPENAI_REASONING_EFFORT=medium

# Cursor Cloud Agents
CURSOR_API_KEY=
CURSOR_API_BASE=https://api.cursor.com

# Claude Code Routine — URL ends in /fire
CLAUDE_ROUTINE_URL=
CLAUDE_ROUTINE_TOKEN=
CLAUDE_ROUTINE_BETA=experimental-cc-routine-2026-04-01

# Gemini Antigravity managed agent
GEMINI_API_KEY=
GEMINI_API_BASE=https://generativelanguage.googleapis.com/v1beta
GEMINI_AGENT=antigravity-preview-05-2026

# Perplexity Agent API
PERPLEXITY_API_KEY=
PERPLEXITY_API_BASE=https://api.perplexity.ai
PERPLEXITY_PRESET=low

# n8n local deployment
N8N_IMAGE=docker.n8n.io/n8nio/n8n:latest
N8N_ENCRYPTION_KEY=REPLACE_WITH_RANDOM_SECRET
N8N_POSTGRES_PASSWORD=REPLACE_WITH_RANDOM_SECRET
