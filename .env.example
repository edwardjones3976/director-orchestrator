# Runtime
APP_ENV=local
LOG_LEVEL=INFO
TZ=America/Los_Angeles
ORCHESTRATOR_BASE_URL=http://orchestrator:8080
ORCHESTRATOR_SHARED_SECRET=REPLACE_WITH_RANDOM_SECRET
ALLOW_PAID_RUNS=false
MAX_AGENT_HOPS=6
MAX_REVISIONS=2
MAX_TASK_BUDGET_USD=2.00
WORKLOAD_POLICY_ENABLED=true
WORKLOAD_POLICY_MODE=enforced
WORKLOAD_POLICY_WINDOW_ASSIGNMENTS=20
WORKLOAD_POLICY_SHADOW_ASSIGNMENTS=5
PROVIDER_POLL_SECONDS=15
PROVIDER_TIMEOUT_SECONDS=3600
SQLITE_PATH=/data/director.sqlite3

# [[Codex | GPT-5.6 | 2026-08-22 16:05 UTC | BEGIN]]
# Default-on LangGraph proof lanes. These use state separate from the legacy task store.
LANGGRAPH_SHADOW_ENABLED=true
LANGGRAPH_APPROVAL_RESUME_ENABLED=true
LANGGRAPH_CHECKPOINT_PATH=/data/langgraph-shadow.sqlite3
LANGGRAPH_CHECKPOINT_NAMESPACE=director-local-shadow-v1
# [[Codex | GPT-5.6 | 2026-08-22 16:05 UTC | END]]

# [[OpenAI Codex | GPT-5.6 | 2026-09-01 | 09:41 UTC | BEGIN]]
# Default-profile LangGraph-primary control plane. Compose provides the internal
# DSN from LANGGRAPH_PRIMARY_POSTGRES_PASSWORD. These switches do not authorize
# live intake, provider calls, Slack/GitHub effects, or paid execution.
LANGGRAPH_PRIMARY_ENABLED=false
LANGGRAPH_PRIMARY_NEW_INTAKE_ENABLED=false
LANGGRAPH_PRIMARY_OFFLINE_SIMULATION_ENABLED=false
LANGGRAPH_PRIMARY_LIVE_PROVIDER_DISPATCH_ENABLED=false
LANGGRAPH_PRIMARY_REQUIRED_PROVIDERS=openai,claude,cursor,grok,antigravity,perplexity,firecrawl,github-copilot
LANGGRAPH_PRIMARY_PROVIDER_ACTIVATION_BINDINGS_JSON={}
# Optional paid-off canary authority. Set both to exact 40-hex Git object IDs;
# leave both empty to retain origin-tracking branch verification.
LANGGRAPH_PRIMARY_PINNED_COMMIT_SHA=
LANGGRAPH_PRIMARY_PINNED_TREE_SHA=
# When the registered project repository differs from the accepted Director
# service candidate, pin the clean project snapshot separately. Both values are
# required together; leave both empty to reuse LANGGRAPH_PRIMARY_PINNED_*.
LANGGRAPH_PRIMARY_PROJECT_EXECUTION_PINNED_COMMIT_SHA=
LANGGRAPH_PRIMARY_PROJECT_EXECUTION_PINNED_TREE_SHA=
LANGGRAPH_PRIMARY_SNAPSHOT_MAX_FILES=512
LANGGRAPH_PRIMARY_POSTGRES_DSN=
LANGGRAPH_PRIMARY_POSTGRES_SCHEMA=director_primary_v1
LANGGRAPH_PRIMARY_CHECKPOINT_NAMESPACE=default-director-primary-v1
LANGGRAPH_PRIMARY_OWNER_TOKEN=REPLACE_WITH_DISTINCT_RANDOM_SECRET
LANGGRAPH_PRIMARY_ADAPTER_CALLBACK_SECRET=REPLACE_WITH_DISTINCT_RANDOM_SECRET
LANGGRAPH_PRIMARY_INDEPENDENT_REVIEW_EVIDENCE_SECRET=REPLACE_WITH_DISTINCT_RANDOM_SECRET
LANGGRAPH_PRIMARY_CI_EVIDENCE_SECRET=REPLACE_WITH_DISTINCT_RANDOM_SECRET
LANGGRAPH_PRIMARY_SECURITY_EVIDENCE_SECRET=REPLACE_WITH_DISTINCT_RANDOM_SECRET
LANGGRAPH_PRIMARY_COMPLETION_EVIDENCE_ACTOR_ALLOWLIST_JSON={"independent_review":{"issuers":["REPLACE_WITH_REVIEW_ISSUER"],"principals":["REPLACE_WITH_REVIEWER_PRINCIPAL"]},"ci":{"issuers":["REPLACE_WITH_CI_ISSUER"],"principals":["REPLACE_WITH_CI_PRINCIPAL"]},"security":{"issuers":["REPLACE_WITH_SECURITY_ISSUER"],"principals":["REPLACE_WITH_SECURITY_PRINCIPAL"]}}
LANGGRAPH_PRIMARY_ACTIVATION_SECURITY_REVIEWER_ALLOWLIST_JSON=["REPLACE_WITH_SECURITY_GITHUB_LOGIN"]
LANGGRAPH_PRIMARY_ACTIVATION_INDEPENDENT_REVIEWER_ALLOWLIST_JSON=["REPLACE_WITH_INDEPENDENT_GITHUB_LOGIN"]
LANGGRAPH_PRIMARY_EFFECT_RECONCILIATION_SECRET=REPLACE_WITH_DISTINCT_RANDOM_SECRET
LANGGRAPH_PRIMARY_ALLOW_INSECURE_LOCAL_POSTGRES=false
LANGGRAPH_PRIMARY_POSTGRES_PASSWORD=REPLACE_WITH_DISTINCT_RANDOM_SECRET
# Optional authenticated bridge from Linux Docker to bounded Windows-native
# provider adapters. Cursor stays direct.
LANGGRAPH_PRIMARY_HOST_BRIDGE_ENDPOINT=https://host.docker.internal:18765/v1/provider/dispatch
LANGGRAPH_PRIMARY_HOST_BRIDGE_SECRET=REPLACE_WITH_DISTINCT_RANDOM_SECRET
DIRECTOR_HOST_PROVIDER_BIND=0.0.0.0
DIRECTOR_HOST_PROVIDER_TLS_CERT_FILE=
DIRECTOR_HOST_PROVIDER_TLS_KEY_FILE=
DIRECTOR_HOST_PROVIDER_PORT=18765
DIRECTOR_HOST_PROVIDER_TIMEOUT_SECONDS=900
DIRECTOR_HOST_PROVIDER_WORKSPACE=
DIRECTOR_HOST_PROVIDER_BRIDGE_STORE=
DIRECTOR_HOST_PROVIDER_POSTGRES_DSN=
DIRECTOR_HOST_PROVIDER_COMMANDS_JSON={}
# [[OpenAI Codex | GPT-5.6 | 2026-09-01 | 09:41 UTC | END]]
PROJECT_ALLOWLIST=
REPOSITORY_ALLOWLIST=
ALLOWED_STARTING_REFS=main
# Rights provisioned automatically against a verified install. Unset means no
# subject holds any provisioned right, which is the default and matches the
# Default-off PostgreSQL entitlement control plane. See docs/entitlement-control-plane.md.
ENTITLEMENT_CONTROL_PLANE_ENABLED=false
ENTITLEMENT_POSTGRES_DSN_FILE=
ENTITLEMENT_POSTGRES_SCHEMA=entitlement_control_plane_v1
ENTITLEMENT_TRUSTED_VERIFIER_SECRET_FILE=
ENTITLEMENT_ROUTE_VERIFIER_SECRET_FILE=
ENTITLEMENT_OWNER_AUTHORITY_SECRET_FILE=
ENTITLEMENT_ALLOW_INSECURE_LOCAL_POSTGRES=false

# Periodic provider availability/usage prompts. Explicitly opt in only after provider limits are set.
USAGE_CHECK_ENABLED=false
USAGE_CHECK_INTERVAL_MINUTES=360
USAGE_CHECK_INITIAL_DELAY_SECONDS=60
USAGE_CHECK_PROVIDER_DELAY_SECONDS=5
USAGE_CHECK_TIMEOUT_SECONDS=300
USAGE_CHECK_MAX_OUTPUT_TOKENS=96
USAGE_CHECK_PROVIDERS=openai,claude,cursor,grok

# Owner subscription context for routing. Consumer plans do not imply API quota.
PRIMARY_TEAM=openai,claude,cursor,grok
PRIMARY_WORKHORSE=cheapest_capable
# Required before paid workload routing. Supply one unique positive cost rank for every ready specialist; lower means cheaper.
TRUSTED_PROVIDER_COST_RANKS=
# Owner-set intake routing. Never parsed from Slack message text. Empty values keep today's behavior.
# One of: engineering, mixed, public_research, enterprise.
INTAKE_ALLOCATION_PROFILE=engineering
# Comma-separated subset of: public_research, bounded_scaffolding, repository_assistance.
# bounded_scaffolding makes the Antigravity lane selectable; repository_assistance makes the GitHub Copilot
# lane selectable and then needs a github-copilot entry in TRUSTED_PROVIDER_COST_RANKS. enterprise_context
# is refused: no scoped enterprise production adapter exists. See docs/provider-setup.md.
INTAKE_PRIMARY_REQUIRED_CAPABILITIES=
CLAUDE_ACCOUNT_CONTEXT=Claude Max 5x
OPENAI_ACCOUNT_CONTEXT=OpenAI Pro 20x; OpenAI API usage is billed separately
OTHER_PROVIDER_ACCOUNT_CONTEXT=Lower-capacity paid services per owner; API billing and quotas must be verified separately

# Slack — create from slack-app-manifest.yaml
SLACK_APP_TOKEN=
SLACK_BOT_TOKEN=
SLACK_DIRECTOR_CHANNEL_ID=C0BQ6GSCNLR
SLACK_OWNER_USER_ID=U0B9UJ86D27
SLACK_GATEWAY_SECRET=REPLACE_WITH_DISTINCT_RANDOM_SECRET
N8N_DIRECTOR_WEBHOOK_URL=http://n8n:5678/webhook/director-intake

# [[Codex | GPT-5.6 | 2026-08-23 08:31 UTC | BEGIN]]
# Owner-only shared-channel alias for the official ChatGPT Slack identity.
# Every paid answer needs a second signed owner approval. Ambiguous Slack delivery
# needs an explicit owner RECOVER command and may duplicate an accepted message.
# Temporary encrypted recovery expires; rotating gateway/internal secrets invalidates it.
# Replies are posted honestly by Aesop Director; no work-order authority is granted.
CHATGPT_BRIDGE_ENABLED=false
# Conversation-only paid opt-in. Does not enable the main provider runtime.
# To stop bridge calls regardless of the global switch, set CHATGPT_BRIDGE_ENABLED=false.
CHATGPT_BRIDGE_ALLOW_PAID_RUNS=false
CHATGPT_BRIDGE_SLACK_USER_ID=U0B9KFJPST1
CHATGPT_BRIDGE_CHANNEL_IDS=C0BQ6GSCNLR,C0BAV9CMC80
CHATGPT_BRIDGE_MAX_PROMPT_CHARS=4000
CHATGPT_BRIDGE_MAX_OUTPUT_TOKENS=600
CHATGPT_BRIDGE_REQUESTS_PER_MINUTE=4
CHATGPT_BRIDGE_ESTIMATED_COST_USD=0.10
CHATGPT_BRIDGE_DAILY_BUDGET_USD=2.00
# [[Codex | GPT-5.6 | 2026-08-23 08:31 UTC | END]]

# Project leadership is Claude; this switch selects a separate runtime adapter.
# Keep false until a trusted native packet binder/authenticator is supplied.
# True without that dependency fails closed; native login alone is insufficient.
CLAUDE_DIRECTOR_ENABLED=false

# Legacy OpenAI Director runtime — API billing is separate from ChatGPT subscriptions
OPENAI_API_KEY=
OPENAI_DIRECTOR_MODEL=gpt-5.6
OPENAI_REASONING_EFFORT=medium
# Trusted minimum reservation for each paid counter-bias, synthesis, or tie turn.
OPENAI_DEBATE_TURN_ESTIMATED_COST_USD=0.05

# Cursor Cloud Agents
CURSOR_API_KEY=
CURSOR_API_BASE=https://api.cursor.com
CURSOR_DISPATCH_MAX_ATTEMPTS=4
CURSOR_DISPATCH_MAX_RETRY_DELAY_SECONDS=60

# Claude Code Routine — URL ends in /fire
CLAUDE_ROUTINE_URL=
CLAUDE_ROUTINE_TOKEN=
CLAUDE_CALLBACK_SECRET=
CLAUDE_ROUTINE_BETA=experimental-cc-routine-2026-04-01

# Gemini Antigravity managed agent
GEMINI_API_KEY=
GEMINI_API_BASE=https://generativelanguage.googleapis.com/v1beta
GEMINI_AGENT=antigravity-preview-05-2026
GEMINI_API_REVISION=2026-05-20
GEMINI_USAGE_MODEL=gemini-3.5-flash-lite
GEMINI_USAGE_MAX_ATTEMPTS=3
GEMINI_USAGE_MAX_RETRY_DELAY_SECONDS=8
GEMINI_MAX_TOTAL_TOKENS=20000
GEMINI_DAILY_BUDGET_USD=2.00
GEMINI_DAILY_REQUEST_LIMIT=50
# Antigravity subordinate lane; readiness fails closed on any other value.
GEMINI_MODE=antigravity_subordinate
GEMINI_ALLOW_REVIEW_VERDICT=false
GEMINI_ALLOW_PRIMARY_AUTHORITY=false

# xAI Grok primary Cursor-family teammate. The API contact remains tool-free;
# Grok Build and Grok Bot are separate repository-capable contacts.
GROK_ENABLED=false
XAI_API_KEY=
GROK_API_BASE=https://api.x.ai/v1
GROK_MODEL=grok-4.6
GROK_MODE=cursor_family_primary
GROK_TIMEOUT_SECONDS=180
GROK_MAX_OUTPUT_TOKENS=4096
GROK_MAX_CONTEXT_CHARS=262144
GROK_DAILY_BUDGET_USD=2.00
GROK_DAILY_REQUEST_LIMIT=50
GROK_REQUEST_COST_FLOOR_USD=0.01
GROK_ALLOW_TOOLS=false
GROK_ALLOW_REPOSITORY_WRITE=false
GROK_ALLOW_REVIEW_VERDICT=false
GROK_CLI_ENABLED=false
GROK_CLI_EXECUTABLE=
GROK_CLI_EXECUTABLE_SHA256=
GROK_CLI_REPOSITORY_MAP_JSON={}
GROK_CLI_TIMEOUT_SECONDS=3600
GROK_CLI_MAX_TURNS=20

# Perplexity API Platform (raw Search API for assignments)
PERPLEXITY_ENABLED=false
PERPLEXITY_API_KEY=
PERPLEXITY_API_BASE=https://api.perplexity.ai
PERPLEXITY_PRESET=fast-search
PERPLEXITY_MODE=research_only
PERPLEXITY_MAX_RESULTS=10
PERPLEXITY_SEARCH_CONTEXT_SIZE=high
PERPLEXITY_TIMEOUT_SECONDS=180
PERPLEXITY_DAILY_BUDGET_USD=2.00
PERPLEXITY_DAILY_REQUEST_LIMIT=100
PERPLEXITY_ALLOW_REPOSITORY_WRITE=false
PERPLEXITY_ALLOW_REVIEW_VERDICT=false

# Z.ai GLM Coding Plan: trial-only contact lane (owner directive #207).
# Not a production provider; the lane refuses to widen at startup.
ZAI_TRIAL_ENABLED=false
ZAI_API_KEY=
ZAI_API_BASE=https://api.z.ai/api/anthropic
ZAI_MODE=trial_only
ZAI_MODEL=glm-5.3-flash
ZAI_CLI_EXECUTABLE=
ZAI_TRIAL_JOURNAL_DIR=
ZAI_TRIAL_LEDGER_PATH=
ZAI_TIMEOUT_SECONDS=60
ZAI_LITE_ENTITLEMENT_VERIFIED=false
ZAI_PRODUCTION_ACTIVATION=
ZAI_ALLOW_REPOSITORY_WRITE=false
ZAI_ALLOW_REVIEW_VERDICT=false

# n8n local deployment
N8N_IMAGE=docker.n8n.io/n8nio/n8n:latest@sha256:d91033b4fac2f7b75c5c4007e10824c66147f7d7a3cccb488720e97452ee7dc7
N8N_ENCRYPTION_KEY=REPLACE_WITH_RANDOM_SECRET
N8N_POSTGRES_PASSWORD=REPLACE_WITH_RANDOM_SECRET
