{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/edwardjones3976/director-orchestrator/docs/schemas/director-gate-ledger-v1.schema.json",
  "title": "Director Completion Gate Ledger v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "document_type",
    "digest_profile",
    "ledger_series_id",
    "ledger_id",
    "ledger_revision",
    "predecessor_ledger_digest",
    "ledger_state",
    "task_id",
    "assignment_id",
    "work_packet_digest",
    "authority_snapshot_digest",
    "repository",
    "starting_ref",
    "starting_sha",
    "expected_head_sha",
    "candidate_result_digest",
    "logical_producer",
    "material_authors",
    "path_scope",
    "execution_profile",
    "runner_registry_digest",
    "issued_by",
    "director_gate_set_digest",
    "producer_gate_set_digest",
    "director_gates",
    "producer_added_gates",
    "ledger_digest"
  ],
  "properties": {
    "schema_version": {
      "const": "director-gate-ledger/v1"
    },
    "document_type": {
      "const": "director-gate-ledger"
    },
    "digest_profile": {
      "const": "rfc8785-sha256-domain-separated/v1"
    },
    "ledger_series_id": {
      "$ref": "#/$defs/stableId"
    },
    "ledger_id": {
      "$ref": "#/$defs/stableId"
    },
    "ledger_revision": {
      "type": "integer",
      "minimum": 1,
      "maximum": 1000
    },
    "predecessor_ledger_digest": {
      "$ref": "#/$defs/nullableDigest"
    },
    "ledger_state": {
      "enum": [
        "PLANNED",
        "HEAD_BOUND"
      ]
    },
    "task_id": {
      "$ref": "#/$defs/stableId"
    },
    "assignment_id": {
      "$ref": "#/$defs/stableId"
    },
    "work_packet_digest": {
      "$ref": "#/$defs/digest"
    },
    "authority_snapshot_digest": {
      "$ref": "#/$defs/digest"
    },
    "repository": {
      "$ref": "#/$defs/repository"
    },
    "starting_ref": {
      "type": "string",
      "minLength": 1,
      "maxLength": 255,
      "pattern": "^[^\\u0000-\\u001f\\u007f]+$"
    },
    "starting_sha": {
      "$ref": "#/$defs/gitSha"
    },
    "expected_head_sha": {
      "$ref": "#/$defs/nullableGitSha"
    },
    "candidate_result_digest": {
      "$ref": "#/$defs/nullableDigest"
    },
    "logical_producer": {
      "$ref": "#/$defs/logicalProvider"
    },
    "material_authors": {
      "type": "array",
      "maxItems": 16,
      "items": {
        "$ref": "#/$defs/materialAuthor"
      }
    },
    "path_scope": {
      "type": "array",
      "minItems": 1,
      "maxItems": 128,
      "items": {
        "$ref": "#/$defs/repositoryRelativePath"
      }
    },
    "execution_profile": {
      "enum": [
        "LOCAL",
        "ISOLATED_PROOF_LANE",
        "TRUSTED_CI"
      ]
    },
    "runner_registry_digest": {
      "$ref": "#/$defs/digest"
    },
    "issued_by": {
      "$ref": "#/$defs/directorIssuer"
    },
    "director_gate_set_digest": {
      "$ref": "#/$defs/digest"
    },
    "producer_gate_set_digest": {
      "$ref": "#/$defs/digest"
    },
    "director_gates": {
      "type": "array",
      "minItems": 1,
      "maxItems": 128,
      "contains": {
        "type": "object",
        "required": [
          "requiredness"
        ],
        "properties": {
          "requiredness": {
            "const": "REQUIRED"
          }
        }
      },
      "minContains": 1,
      "items": {
        "$ref": "#/$defs/directorGate"
      }
    },
    "producer_added_gates": {
      "type": "array",
      "maxItems": 128,
      "items": {
        "$ref": "#/$defs/producerGate"
      }
    },
    "ledger_digest": {
      "$ref": "#/$defs/digest"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "ledger_revision": {
            "const": 1
          }
        },
        "required": [
          "ledger_revision"
        ]
      },
      "then": {
        "properties": {
          "predecessor_ledger_digest": {
            "type": "null"
          },
          "ledger_state": {
            "const": "PLANNED"
          }
        }
      },
      "else": {
        "properties": {
          "predecessor_ledger_digest": {
            "$ref": "#/$defs/digest"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "ledger_state": {
            "const": "PLANNED"
          }
        },
        "required": [
          "ledger_state"
        ]
      },
      "then": {
        "properties": {
          "expected_head_sha": {
            "type": "null"
          },
          "candidate_result_digest": {
            "type": "null"
          },
          "material_authors": {
            "maxItems": 0
          }
        }
      },
      "else": {
        "properties": {
          "ledger_revision": {
            "minimum": 2
          },
          "expected_head_sha": {
            "$ref": "#/$defs/gitSha"
          },
          "candidate_result_digest": {
            "$ref": "#/$defs/digest"
          },
          "material_authors": {
            "minItems": 1
          }
        }
      }
    }
  ],
  "$defs": {
    "digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "nullableDigest": {
      "oneOf": [
        {
          "$ref": "#/$defs/digest"
        },
        {
          "type": "null"
        }
      ]
    },
    "gitSha": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "nullableGitSha": {
      "oneOf": [
        {
          "$ref": "#/$defs/gitSha"
        },
        {
          "type": "null"
        }
      ]
    },
    "stableId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
    },
    "repository": {
      "type": "string",
      "maxLength": 200,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9-]{0,38}/[A-Za-z0-9][A-Za-z0-9_.-]{0,99}$"
    },
    "repositoryRelativePath": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512,
      "pattern": "^(?:\\.|(?!/)(?!.*//)(?!.*[/]$)(?!.*(?:^|/)\\.{1,2}(?:/|$))(?!.*(?:^|/)\\.[Gg][Ii][Tt](?:/|$))(?!.*(?:^|/)(?:[Cc][Oo][Nn]|[Pp][Rr][Nn]|[Aa][Uu][Xx]|[Nn][Uu][Ll]|[Cc][Oo][Mm][1-9]|[Ll][Pp][Tt][1-9])(?:\\.[^/]*|/|$))(?!.*(?:^|/)[^/]*[ .](?:/|$))[A-Za-z0-9._@+/-]+)$"
    },
    "logicalProvider": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "provider_id",
        "system_label"
      ],
      "properties": {
        "provider_id": {
          "$ref": "#/$defs/stableId"
        },
        "system_label": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        }
      }
    },
    "materialAuthor": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "identity_kind",
        "provider_id",
        "authenticated_principal",
        "evidence_source",
        "run_reference"
      ],
      "properties": {
        "identity_kind": {
          "enum": [
            "PROVIDER",
            "HUMAN",
            "TOOL"
          ]
        },
        "provider_id": {
          "$ref": "#/$defs/stableId"
        },
        "authenticated_principal": {
          "$ref": "#/$defs/stableId"
        },
        "evidence_source": {
          "enum": [
            "DIRECTOR_PROVIDER_RUN",
            "GITHUB_COMMIT_READBACK",
            "OWNER_ATTESTATION"
          ]
        },
        "run_reference": {
          "$ref": "#/$defs/stableId"
        }
      }
    },
    "directorIssuer": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "role",
        "authenticated_principal",
        "issuance_record_digest",
        "issued_at"
      ],
      "properties": {
        "role": {
          "const": "DIRECTOR"
        },
        "authenticated_principal": {
          "$ref": "#/$defs/stableId"
        },
        "issuance_record_digest": {
          "$ref": "#/$defs/digest"
        },
        "issued_at": {
          "type": "string",
          "format": "date-time"
        }
      }
    },
    "gateAuthor": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "role",
        "provider_id",
        "authenticated_proposal_digest"
      ],
      "properties": {
        "role": {
          "enum": [
            "DIRECTOR",
            "PRODUCER"
          ]
        },
        "provider_id": {
          "$ref": "#/$defs/stableId"
        },
        "authenticated_proposal_digest": {
          "$ref": "#/$defs/nullableDigest"
        }
      }
    },
    "directorGateAuthor": {
      "allOf": [
        {
          "$ref": "#/$defs/gateAuthor"
        },
        {
          "properties": {
            "role": {
              "const": "DIRECTOR"
            },
            "authenticated_proposal_digest": {
              "type": "null"
            }
          }
        }
      ]
    },
    "producerGateAuthor": {
      "allOf": [
        {
          "$ref": "#/$defs/gateAuthor"
        },
        {
          "properties": {
            "role": {
              "const": "PRODUCER"
            },
            "authenticated_proposal_digest": {
              "$ref": "#/$defs/digest"
            }
          }
        }
      ]
    },
    "dependency": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "gate_id",
        "required_status"
      ],
      "properties": {
        "gate_id": {
          "$ref": "#/$defs/stableId"
        },
        "required_status": {
          "const": "PASS"
        }
      }
    },
    "abandonmentPolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "permitted",
        "allowed_reason_codes",
        "required_gate_effects"
      ],
      "properties": {
        "permitted": {
          "type": "boolean"
        },
        "allowed_reason_codes": {
          "type": "array",
          "maxItems": 16,
          "items": {
            "enum": [
              "PROVIDER_UNAVAILABLE",
              "TOOL_UNAVAILABLE",
              "ENVIRONMENT_UNAVAILABLE",
              "BUDGET_EXHAUSTED",
              "TIMEOUT_EXHAUSTED",
              "OWNER_STOP",
              "SCOPE_RESHAPED"
            ]
          }
        },
        "required_gate_effects": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": [
              "BLOCKS_ACCEPTANCE",
              "OWNER_DECISION_REQUIRED",
              "RESHAPE_REQUIRED"
            ]
          }
        }
      }
    },
    "commonGate": {
      "type": "object",
      "required": [
        "gate_id",
        "order",
        "gate_type",
        "observable_outcome",
        "requiredness",
        "risk_classification",
        "gate_author",
        "dependencies",
        "abandonment_policy",
        "gate_definition_digest"
      ],
      "properties": {
        "gate_id": {
          "$ref": "#/$defs/stableId"
        },
        "order": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1000
        },
        "gate_type": {
          "enum": [
            "RUNNABLE",
            "MANUAL",
            "EXTERNAL_CI"
          ]
        },
        "observable_outcome": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2048
        },
        "requiredness": {
          "enum": [
            "REQUIRED",
            "ADVISORY"
          ]
        },
        "risk_classification": {
          "enum": [
            "LOW",
            "MEDIUM",
            "HIGH",
            "CRITICAL"
          ]
        },
        "gate_author": {
          "$ref": "#/$defs/gateAuthor"
        },
        "dependencies": {
          "type": "array",
          "maxItems": 128,
          "items": {
            "$ref": "#/$defs/dependency"
          }
        },
        "abandonment_policy": {
          "$ref": "#/$defs/abandonmentPolicy"
        },
        "gate_definition_digest": {
          "$ref": "#/$defs/digest"
        }
      }
    },
    "expectedOutput": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "matcher",
        "value",
        "case_sensitive"
      ],
      "properties": {
        "matcher": {
          "enum": [
            "NONE",
            "EXACT",
            "CONTAINS"
          ]
        },
        "value": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 4096
        },
        "case_sensitive": {
          "type": "boolean"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "matcher": {
                "const": "NONE"
              }
            },
            "required": [
              "matcher"
            ]
          },
          "then": {
            "properties": {
              "value": {
                "type": "null"
              }
            }
          },
          "else": {
            "properties": {
              "value": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        }
      ]
    },
    "scriptBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "blob_sha",
        "content_digest",
        "bound_head_sha",
        "approval_digest"
      ],
      "properties": {
        "path": {
          "$ref": "#/$defs/repositoryRelativePath"
        },
        "blob_sha": {
          "$ref": "#/$defs/gitSha"
        },
        "content_digest": {
          "$ref": "#/$defs/digest"
        },
        "bound_head_sha": {
          "$ref": "#/$defs/gitSha"
        },
        "approval_digest": {
          "$ref": "#/$defs/digest"
        }
      }
    },
    "runnableGate": {
      "allOf": [
        {
          "$ref": "#/$defs/commonGate"
        },
        {
          "type": "object",
          "required": [
            "runner_id",
            "runner_definition_digest",
            "parameter_profile_id",
            "parameter_profile_digest",
            "working_directory",
            "expected_exit_code",
            "expected_output",
            "timeout_seconds",
            "output_limit_bytes",
            "script_binding"
          ],
          "properties": {
            "gate_type": {
              "const": "RUNNABLE"
            },
            "runner_id": {
              "enum": [
                "python_unittest",
                "python_compileall",
                "pip_check",
                "json_schema_validate",
                "compose_config",
                "container_build",
                "git_diff_check",
                "secret_hygiene",
                "powershell_parse",
                "repository_owned_script"
              ]
            },
            "runner_definition_digest": {
              "$ref": "#/$defs/digest"
            },
            "parameter_profile_id": {
              "$ref": "#/$defs/stableId"
            },
            "parameter_profile_digest": {
              "$ref": "#/$defs/digest"
            },
            "working_directory": {
              "$ref": "#/$defs/repositoryRelativePath"
            },
            "expected_exit_code": {
              "type": "integer",
              "minimum": 0,
              "maximum": 255
            },
            "expected_output": {
              "$ref": "#/$defs/expectedOutput"
            },
            "timeout_seconds": {
              "type": "integer",
              "minimum": 1,
              "maximum": 3600
            },
            "output_limit_bytes": {
              "type": "integer",
              "minimum": 1,
              "maximum": 10485760
            },
            "script_binding": {
              "oneOf": [
                {
                  "$ref": "#/$defs/scriptBinding"
                },
                {
                  "type": "null"
                }
              ]
            }
          }
        },
        {
          "if": {
            "properties": {
              "runner_id": {
                "const": "repository_owned_script"
              }
            },
            "required": [
              "runner_id"
            ]
          },
          "then": {
            "properties": {
              "script_binding": {
                "$ref": "#/$defs/scriptBinding"
              }
            }
          },
          "else": {
            "properties": {
              "script_binding": {
                "type": "null"
              }
            }
          }
        }
      ],
      "unevaluatedProperties": false
    },
    "manualGate": {
      "allOf": [
        {
          "$ref": "#/$defs/commonGate"
        },
        {
          "type": "object",
          "required": [
            "evidence_requirements",
            "eligible_evaluator_roles",
            "independence_required"
          ],
          "properties": {
            "gate_type": {
              "const": "MANUAL"
            },
            "evidence_requirements": {
              "type": "array",
              "minItems": 1,
              "maxItems": 32,
              "items": {
                "type": "string",
                "minLength": 1,
                "maxLength": 1024
              }
            },
            "eligible_evaluator_roles": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": {
                "enum": [
                  "OWNER",
                  "INDEPENDENT_PROVIDER_REVIEWER",
                  "CODEX_SECURITY"
                ]
              }
            },
            "independence_required": {
              "type": "boolean"
            }
          }
        }
      ],
      "unevaluatedProperties": false
    },
    "externalCiGate": {
      "allOf": [
        {
          "$ref": "#/$defs/commonGate"
        },
        {
          "type": "object",
          "required": [
            "ci_binding"
          ],
          "properties": {
            "gate_type": {
              "const": "EXTERNAL_CI"
            },
            "ci_binding": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "provider",
                "repository",
                "workflow_path",
                "workflow_blob_sha",
                "workflow_definition_digest",
                "required_check_name",
                "trusted_app_id",
                "trusted_app_slug"
              ],
              "properties": {
                "provider": {
                  "const": "GITHUB"
                },
                "repository": {
                  "$ref": "#/$defs/repository"
                },
                "workflow_path": {
                  "$ref": "#/$defs/repositoryRelativePath"
                },
                "workflow_blob_sha": {
                  "$ref": "#/$defs/gitSha"
                },
                "workflow_definition_digest": {
                  "$ref": "#/$defs/digest"
                },
                "required_check_name": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 255
                },
                "trusted_app_id": {
                  "type": "integer",
                  "minimum": 1
                },
                "trusted_app_slug": {
                  "$ref": "#/$defs/stableId"
                }
              }
            }
          }
        }
      ],
      "unevaluatedProperties": false
    },
    "gate": {
      "oneOf": [
        {
          "$ref": "#/$defs/runnableGate"
        },
        {
          "$ref": "#/$defs/manualGate"
        },
        {
          "$ref": "#/$defs/externalCiGate"
        }
      ]
    },
    "directorGate": {
      "allOf": [
        {
          "$ref": "#/$defs/gate"
        },
        {
          "properties": {
            "gate_id": {
              "pattern": "^director\\.[a-z0-9][a-z0-9._-]{0,95}$"
            },
            "gate_author": {
              "$ref": "#/$defs/directorGateAuthor"
            }
          }
        }
      ]
    },
    "producerGate": {
      "allOf": [
        {
          "$ref": "#/$defs/gate"
        },
        {
          "properties": {
            "gate_id": {
              "pattern": "^producer\\.[a-z0-9][a-z0-9_-]{0,31}\\.[a-z0-9][a-z0-9._-]{0,63}$"
            },
            "gate_author": {
              "$ref": "#/$defs/producerGateAuthor"
            }
          }
        }
      ]
    }
  }
}
