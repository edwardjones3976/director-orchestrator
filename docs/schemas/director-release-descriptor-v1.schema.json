{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://director.local/schemas/director-release-descriptor-v1.schema.json",
  "title": "Director R1 preparation and sibling rehearsal descriptor",
  "description": "Preparation input only. Its exact file SHA256 must match release_preparations[release_id] in the single OS-installed owner release descriptor; this document supplies no independent authority.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "release_id", "source", "candidate", "compose_project", "image_id", "runtime_env", "bridge_env", "compose_files", "generation_manifest", "validation_manifest", "bridge_url", "bridge_ca", "snapshot", "reviewers", "executables", "output_directory", "timeout_seconds"],
  "properties": {
    "schema_version": {"const": "director-release-descriptor/v1"},
    "release_id": {"type": "string", "pattern": "^[a-z][a-z0-9-]{0,47}$", "description": "Exact key in the owner descriptor's release_preparations mapping; final and sibling preparations each need their own pin."},
    "source": {"$ref": "#/$defs/path"},
    "candidate": {
      "type": "object", "additionalProperties": false, "required": ["commit", "tree"],
      "properties": {"commit": {"$ref": "#/$defs/gitSha"}, "tree": {"$ref": "#/$defs/gitSha"}}
    },
    "compose_project": {"type": "string", "pattern": "^[a-z0-9][a-z0-9_-]{1,62}$"},
    "image_id": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "runtime_env": {"$ref": "#/$defs/pin"},
    "bridge_env": {"$ref": "#/$defs/pin"},
    "compose_files": {"type": "array", "minItems": 1, "maxItems": 8, "uniqueItems": true, "items": {"$ref": "#/$defs/pin"}},
    "generation_manifest": {"$ref": "#/$defs/pin"},
    "validation_manifest": {"$ref": "#/$defs/pin"},
    "bridge_url": {"type": "string", "minLength": 12, "maxLength": 512, "pattern": "^https://[^/?#@]+/v1/provider/configuration-digest$"},
    "bridge_ca": {"$ref": "#/$defs/pin"},
    "snapshot": {
      "type": "object", "additionalProperties": false,
      "required": ["path", "repository", "starting_ref", "remote", "commit", "tree"],
      "properties": {
        "path": {"$ref": "#/$defs/path"},
        "repository": {"type": "string", "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$"},
        "starting_ref": {"type": "string", "minLength": 1, "maxLength": 200, "pattern": "^(?!-)[^\\u0000-\\u0020]+(?![\\s\\S])"},
        "remote": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$"},
        "commit": {"$ref": "#/$defs/gitSha"}, "tree": {"$ref": "#/$defs/gitSha"}
      }
    },
    "reviewers": {
      "type": "object", "additionalProperties": false, "required": ["independent", "security"],
      "properties": {"independent": {"$ref": "#/$defs/actor"}, "security": {"$ref": "#/$defs/actor"}}
    },
    "executables": {
      "type": "object", "additionalProperties": false, "required": ["python", "powershell"],
      "properties": {"python": {"$ref": "#/$defs/path"}, "powershell": {"$ref": "#/$defs/path"}}
    },
    "output_directory": {"$ref": "#/$defs/path"},
    "rehearsal": {
      "type": "object", "additionalProperties": false,
      "required": ["descriptor", "acceptance_artifact", "backup_path", "host_port"],
      "properties": {
        "descriptor": {"$ref": "#/$defs/pin"},
        "acceptance_artifact": {"$ref": "#/$defs/pin"},
        "backup_path": {"$ref": "#/$defs/path"},
        "host_port": {"type": "integer", "minimum": 1024, "maximum": 65535}
      }
    },
    "timeout_seconds": {"type": "integer", "minimum": 1, "maximum": 900}
  },
  "$defs": {
    "path": {"type": "string", "minLength": 1, "maxLength": 4096, "pattern": "^[^\\u0000\\r\\n]+$"},
    "gitSha": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "actor": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9-]{0,38}$"},
    "pin": {"type": "object", "additionalProperties": false, "required": ["path", "sha256"], "properties": {"path": {"$ref": "#/$defs/path"}, "sha256": {"$ref": "#/$defs/digest"}}}
  }
}
