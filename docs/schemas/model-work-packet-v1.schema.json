{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/edwardjones3976/director-orchestrator/docs/schemas/model-work-packet-v1.schema.json",
  "title": "Director Model Work Packet v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "task_id",
    "assignment_id",
    "project",
    "repository",
    "starting_ref",
    "objective",
    "non_goals",
    "authority_snapshot",
    "authority_snapshot_digest",
    "dependencies",
    "constraints",
    "prohibited_actions",
    "allowed_tools",
    "allowed_external_effects",
    "acceptance_checks",
    "evidence_requirements",
    "approval_requirements",
    "limits",
    "idempotency_key",
    "correlation"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "task_id": {
      "type": "string",
      "minLength": 1
    },
    "assignment_id": {
      "type": "string",
      "minLength": 1
    },
    "project": {
      "type": "string",
      "minLength": 1
    },
    "repository": {
      "type": "string",
      "pattern": "^[^/]+/[^/]+$"
    },
    "starting_ref": {
      "type": "string",
      "minLength": 1
    },
    "objective": {
      "type": "string",
      "minLength": 1
    },
    "non_goals": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "authority_snapshot": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "path",
          "commit_sha",
          "blob_sha"
        ],
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1
          },
          "commit_sha": {
            "type": "string",
            "pattern": "^[0-9a-f]{40}$"
          },
          "blob_sha": {
            "type": "string",
            "pattern": "^[0-9a-f]{40}$"
          }
        }
      }
    },
    "authority_snapshot_digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "dependencies": {
      "type": "array",
      "default": [],
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "assignment_id",
          "accepted_outcome_digest"
        ],
        "properties": {
          "assignment_id": {
            "type": "string",
            "minLength": 1
          },
          "accepted_outcome_digest": {
            "type": "string",
            "pattern": "^sha256:[0-9a-f]{64}$"
          }
        }
      }
    },
    "constraints": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "prohibited_actions": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "allowed_tools": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "allowed_external_effects": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "acceptance_checks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "evidence_requirements": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "approval_requirements": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "limits": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "budget_usd",
        "timeout_seconds",
        "max_hops",
        "max_revisions"
      ],
      "properties": {
        "budget_usd": {
          "type": "number",
          "minimum": 0
        },
        "timeout_seconds": {
          "type": "integer",
          "minimum": 1
        },
        "max_hops": {
          "type": "integer",
          "minimum": 0
        },
        "max_revisions": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "idempotency_key": {
      "type": "string",
      "minLength": 1
    },
    "correlation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "correlation_id",
        "source_event_id"
      ],
      "properties": {
        "correlation_id": {
          "type": "string",
          "minLength": 1
        },
        "source_event_id": {
          "type": "string",
          "minLength": 1
        },
        "slack_thread_ts": {
          "type": [
            "string",
            "null"
          ]
        },
        "github_issue": {
          "type": [
            "string",
            "null"
          ]
        },
        "github_pull_request": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    }
  }
}
