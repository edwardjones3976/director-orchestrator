# Project Uppercut isolated deployment profile. Copy to .env.uppercut locally.
# Never commit the populated .env.uppercut file.

# Runtime and Docker isolation
APP_ENV=project-uppercut
LOG_LEVEL=INFO
TZ=America/Los_Angeles
DIRECTOR_COMPOSE_PROJECT_NAME=project-uppercut-director
DIRECTOR_HOST_PORT=18080
N8N_HOST_PORT=15678
ORCHESTRATOR_BASE_URL=http://orchestrator:8080
ORCHESTRATOR_SHARED_SECRET=REPLACE_WITH_RANDOM_SECRET
ALLOW_PAID_RUNS=false
MAX_AGENT_HOPS=6
MAX_REVISIONS=2
MAX_TASK_BUDGET_USD=2.00
PROVIDER_POLL_SECONDS=15
PROVIDER_TIMEOUT_SECONDS=3600
SQLITE_PATH=/data/project-uppercut.sqlite3
PROJECT_ALLOWLIST=project-uppercut
REPOSITORY_ALLOWLIST=edwardjones3976/Project-Uppercut
ALLOWED_STARTING_REFS=main

# Periodic provider availability checks
USAGE_CHECK_ENABLED=false
USAGE_CHECK_INTERVAL_MINUTES=360
USAGE_CHECK_INITIAL_DELAY_SECONDS=60
USAGE_CHECK_PROVIDER_DELAY_SECONDS=5
USAGE_CHECK_TIMEOUT_SECONDS=300
USAGE_CHECK_MAX_OUTPUT_TOKENS=96
USAGE_CHECK_PROVIDERS=openai,claude,cursor

# Team routing
PRIMARY_TEAM=openai,claude,cursor
PRIMARY_WORKHORSE=claude
CLAUDE_ACCOUNT_CONTEXT=Claude Pro 20x
OPENAI_ACCOUNT_CONTEXT=ChatGPT Plus; OpenAI API usage is billed separately
OTHER_PROVIDER_ACCOUNT_CONTEXT=Comparable paid individual tiers; API billing and quotas must be verified separately

# Dedicated Project Uppercut Slack app/channel
SLACK_APP_TOKEN=
SLACK_BOT_TOKEN=
SLACK_DIRECTOR_CHANNEL_ID=C0BP62MBFNK
SLACK_OWNER_USER_ID=U0B9UJ86D27
N8N_DIRECTOR_WEBHOOK_URL=http://n8n:5678/webhook/director-intake

# OpenAI Director
OPENAI_API_KEY=
OPENAI_DIRECTOR_MODEL=gpt-5.6
OPENAI_REASONING_EFFORT=high

# Cursor Cloud Agents
CURSOR_API_KEY=
CURSOR_API_BASE=https://api.cursor.com

# Claude Code Routine
CLAUDE_ROUTINE_URL=
CLAUDE_ROUTINE_TOKEN=
CLAUDE_CALLBACK_SECRET=REPLACE_WITH_RANDOM_SECRET
CLAUDE_ROUTINE_BETA=experimental-cc-routine-2026-04-01

# Optional supplemental providers
GEMINI_API_KEY=
GEMINI_API_BASE=https://generativelanguage.googleapis.com/v1beta
GEMINI_AGENT=antigravity-preview-05-2026
GEMINI_API_REVISION=2026-05-20
PERPLEXITY_ENABLED=false
PERPLEXITY_API_KEY=
PERPLEXITY_API_BASE=https://api.perplexity.ai
PERPLEXITY_PRESET=fast-search
PERPLEXITY_MODE=research_only
PERPLEXITY_MAX_RESULTS=10
PERPLEXITY_SEARCH_CONTEXT_SIZE=high
PERPLEXITY_TIMEOUT_SECONDS=180
PERPLEXITY_DAILY_BUDGET_USD=2.00
PERPLEXITY_ALLOW_REPOSITORY_WRITE=false
PERPLEXITY_ALLOW_REVIEW_VERDICT=false

# Dedicated n8n state
N8N_IMAGE=docker.n8n.io/n8nio/n8n:latest@sha256:d91033b4fac2f7b75c5c4007e10824c66147f7d7a3cccb488720e97452ee7dc7
N8N_ENCRYPTION_KEY=REPLACE_WITH_RANDOM_SECRET
N8N_POSTGRES_PASSWORD=REPLACE_WITH_RANDOM_SECRET
