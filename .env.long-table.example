# The Long Table isolated LangGraph graduation profile.
# Copy to .env.long-table locally. Never commit the populated file.

APP_ENV=long-table
LOG_LEVEL=INFO
TZ=America/Los_Angeles
DIRECTOR_COMPOSE_PROJECT_NAME=long-table-director
DIRECTOR_HOST_PORT=38080
N8N_HOST_PORT=35678
ORCHESTRATOR_BASE_URL=http://orchestrator:8080
ORCHESTRATOR_SHARED_SECRET=REPLACE_WITH_RANDOM_SECRET
ALLOW_PAID_RUNS=false
MAX_AGENT_HOPS=6
MAX_REVISIONS=2
MAX_TASK_BUDGET_USD=1.00
MAX_DAILY_PROVIDER_BUDGET_USD=5.00
PROVIDER_POLL_SECONDS=15
PROVIDER_TIMEOUT_SECONDS=900
SQLITE_PATH=/data/long-table.sqlite3

LANGGRAPH_SHADOW_ENABLED=true
LANGGRAPH_APPROVAL_RESUME_ENABLED=true
LANGGRAPH_CHECKPOINT_PATH=/data/long-table-langgraph-shadow.sqlite3
LANGGRAPH_CHECKPOINT_NAMESPACE=long-table-shadow-v1
LANGGRAPH_RUNTIME_ENABLED=false
LANGGRAPH_RUNTIME_LIVE_DISPATCH_ENABLED=false
LANGGRAPH_RUNTIME_TASK_WRITER_ENABLED=false
LANGGRAPH_RUNTIME_CHECKPOINT_PATH=/data/long-table-langgraph-runtime.sqlite3
LANGGRAPH_RUNTIME_LEDGER_PATH=/data/long-table-langgraph-ledger.sqlite3
LANGGRAPH_RUNTIME_CHECKPOINT_NAMESPACE=long-table-runtime-v1
LANGGRAPH_RUNTIME_WRITER_OWNER_ID=long-table-langgraph-runtime
LANGGRAPH_RUNTIME_WRITER_SECRET=REPLACE_WITH_RANDOM_SECRET
REPOSITORY_SNAPSHOT_HOST_PATH=C:/Users/edwar/.director-snapshots/long-table-main
REPOSITORY_SNAPSHOT_ROOT=/repository

COMPLETION_GATES_ENABLED=false
COMPLETION_GATE_ISOLATED_PROOF_ENABLED=false
COMPLETION_GATE_EXECUTION_TIERS=container
COMPLETION_GATE_STORE_PATH=/data/long-table-completion-gates.sqlite3
COMPLETION_GATE_RESULT_MAX_AGE_SECONDS=86400
COMPLETION_GATE_CONTAINER_IMAGE=python:3.12-slim@sha256:dd29372629eeba2dd003fd9e9d35a5b8236c44727875a0364254b5127af88e65

LANGGRAPH_PARALLEL_EXTERNAL_DISPATCH_ENABLED=false
LANGGRAPH_PARALLEL_KILL_SWITCH=true
LANGGRAPH_PARALLEL_INITIAL_MAX_CONCURRENCY=2
LANGGRAPH_PARALLEL_AUTO_SCALE_MAX_CONCURRENCY=3
LANGGRAPH_PARALLEL_CLEAN_BATCHES_TO_SCALE=10
LANGGRAPH_PARALLEL_RECOVERY_CLEAN_BATCHES=3

PROJECT_ALLOWLIST=long-table-bid-whist
REPOSITORY_ALLOWLIST=edwardjones3976/long-table-bid-whist
ALLOWED_STARTING_REFS=main

USAGE_CHECK_ENABLED=false
USAGE_CHECK_INTERVAL_MINUTES=360
USAGE_CHECK_INITIAL_DELAY_SECONDS=60
USAGE_CHECK_PROVIDER_DELAY_SECONDS=5
USAGE_CHECK_TIMEOUT_SECONDS=300
USAGE_CHECK_MAX_OUTPUT_TOKENS=96
USAGE_CHECK_PROVIDERS=openai,claude,cursor,grok

PRIMARY_TEAM=openai,claude,cursor,grok
PRIMARY_WORKHORSE=claude
CLAUDE_ACCOUNT_CONTEXT=Claude Pro 20x
OPENAI_ACCOUNT_CONTEXT=OpenAI API usage is billed separately
OTHER_PROVIDER_ACCOUNT_CONTEXT=Provider billing and quotas must be verified separately

