# [[Claude Code | Claude Opus 5.5 | 2026-09-24 | 17:03 UTC | BEGIN]]
# Template only. The real file is C:\llm\secrets\open-webui.env, outside the repo in the ACL-restricted
# secrets folder; create it as in RUNBOOK.md section 0. Never commit a filled-in copy.
# Pin images by digest after the approved pull:  docker image inspect <image> --format '{{index .RepoDigests 0}}'
OPEN_WEBUI_IMAGE=ghcr.io/open-webui/open-webui@sha256:<digest>
SEARXNG_IMAGE=searxng/searxng@sha256:<digest>
# Generate each with:  python -c "import secrets; print(secrets.token_hex(32))"
WEBUI_SECRET_KEY=<64 hex chars>
SEARXNG_SECRET=<64 hex chars>
# After `tailscale serve`, set to the https://<host>.<tailnet>.ts.net URL and recreate the container
# (ENABLE_PERSISTENT_CONFIG=false in the compose file makes this file authoritative).
WEBUI_URL=http://127.0.0.1:3000
# true only for the first boot that creates the admin account; then false and recreate the container.
ENABLE_SIGNUP=true
# [[Claude Code | Claude Opus 5.5 | 2026-09-24 | 17:03 UTC | END]]
